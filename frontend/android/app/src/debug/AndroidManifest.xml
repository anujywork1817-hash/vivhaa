<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds only: the backend runs over plain HTTP on localhost
         (via `adb reverse`) or a LAN IP during development. Android 9+
         blocks cleartext (non-HTTPS) traffic by default; this override is
         merged only into debug builds, never release, since a real
         deployment should talk to a real HTTPS backend. -->
    <application android:usesCleartextTraffic="true" tools:replace="android:usesCleartextTraffic"/>
</manifest>
