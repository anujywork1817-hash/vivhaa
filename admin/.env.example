# Base URL of the matrimony_backend Go API (no trailing slash).
#
# Defaults to the shared backend on the local network — the same host the
# Flutter app targets (see frontend/lib/core/api/api_endpoints.dart). Pointing
# this at localhost ties the panel to whichever machine is running
# docker compose, which breaks the moment that machine is down or its DHCP
# lease moves.
#
# For a local backend, set this to your own machine's published API port, e.g.
#   VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=http://192.168.1.222:58080
