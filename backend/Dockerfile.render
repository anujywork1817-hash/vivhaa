# Deployment image for Render.
#
# Differs from the local Dockerfile in two ways:
#
#  1. It builds *all four* service binaries into one image rather than one
#     per image. Render's Blueprint format has no per-service Docker build
#     args, so the same image is deployed four times and each service picks
#     its binary via dockerCommand in render.yaml.
#  2. It bundles the golang-migrate CLI and the migrations/ directory, so
#     schema changes can run as a pre-deploy step. Locally that's a
#     separate migrate/migrate container, which has no equivalent on Render.
FROM golang:1.25-alpine AS builder

WORKDIR /src

RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o /out/api          ./cmd/api && \
    CGO_ENABLED=0 GOOS=linux go build -o /out/worker       ./cmd/worker && \
    CGO_ENABLED=0 GOOS=linux go build -o /out/scheduler    ./cmd/scheduler && \
    CGO_ENABLED=0 GOOS=linux go build -o /out/notification ./cmd/notification

# The postgres build tag is required; without it the CLI compiles but has
# no driver registered and fails at runtime with "unknown driver".
RUN CGO_ENABLED=0 GOOS=linux go install -tags 'postgres' \
    github.com/golang-migrate/migrate/v4/cmd/migrate@v4.18.1

FROM alpine:3.20

RUN apk add --no-cache ca-certificates curl

WORKDIR /app

COPY --from=builder /out/           /app/bin/
COPY --from=builder /go/bin/migrate /usr/local/bin/migrate
COPY --from=builder /src/migrations /app/migrations

EXPOSE 8080

# Overridden per service by render.yaml's dockerCommand.
CMD ["/app/bin/api"]
