# Codifies non-secret environment variables that a failed Elastic
# Beanstalk config-deploy has previously rolled back silently
# (2026-08-24 incident: KAFKA_BROKERS/ES_ADDRESSES reverted to a stale
# localhost snapshot, causing /search/profiles to fail with
# dial-refused / timeout errors).
#
# Baking these into the deployed bundle means every application-version
# deploy re-asserts the correct value from source control, instead of
# depending on a console-set variable that can silently drift or get
# rolled back. If the shared supporting-services host
# (Kafka/Elasticsearch/Redis/MinIO/Postgres) ever moves, update the
# IP/host here and redeploy — do not edit this only in the Beanstalk
# console, or the next config-deploy rollback can silently undo it again.
#
# Deliberately NOT included here: DB_PASSWORD, JWT_ACCESS_SECRET,
# JWT_REFRESH_SECRET, RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET,
# S3_ACCESS_KEY, S3_SECRET_KEY, TURN_SECRET. These are credentials —
# committing them to source control (even a private repo) is a
# separate, worse risk than the config-drift problem this file solves.
# They remain Beanstalk console / Parameter Store only. If they ever
# need hardening against the same rollback failure mode, migrate them
# to AWS Systems Manager Parameter Store (SecureString) referenced from
# option_settings, not into this file directly.
option_settings:
  # An Application Load Balancer's target-group health check defaults to
  # GET / — this app has no such route (404), so a fresh ALB-backed
  # environment reports Red/unhealthy from an actual passing app the
  # instant it's created, purely from a health-check-path mismatch (hit
  # standing up vivaha-api-prod-alb, the replacement for the original
  # vivaha-api-prod's Classic Load Balancer — see api_endpoints.dart's
  # doc comment for why that replacement was needed at all).
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: "/health"
  aws:elasticbeanstalk:application:environment:
    APP_ENV: "prod"
    HTTP_PORT: "8080"
    CHAT_MODERATION_ENABLED: "true"
    PREMIUM_GATING_ENABLED: "false"
    # The plain-http admin/web Beanstalk origins are kept alongside their
    # CloudFront https fronts for now (harmless to allow both), but the
    # admin panel specifically MUST be accessed via the https CloudFront
    # URL going forward — its auth cookies are set with Secure (gated on
    # APP_ENV=prod, see auth/handler.go), which browsers silently refuse
    # to store on a plain-http page, making login appear to succeed then
    # bounce straight back to the login screen on refresh.
    CORS_ALLOWED_ORIGINS: "http://vivaha-admin-prod.eba-pbwribyn.ap-south-1.elasticbeanstalk.com,https://d1fqoukd3a954u.cloudfront.net,http://vivaha-web-prod.eba-vguvs7jz.ap-south-1.elasticbeanstalk.com,https://d7c4qwn4lr2k8.cloudfront.net"
    GOOGLE_OAUTH_CLIENT_IDS: "879856026168-a82vq1aco24pr25gq540m5qe5e7rc4eq.apps.googleusercontent.com"
    DB_HOST: "vivaha-db.c12wueweo2b2.ap-south-1.rds.amazonaws.com"
    DB_PORT: "5432"
    DB_NAME: "myapp"
    DB_USER: "postgres"
    DB_SSLMODE: "require"
    REDIS_ADDR: "172.31.5.27:56379"
    KAFKA_BROKERS: "172.31.5.27:59092"
    ES_ADDRESSES: "http://172.31.5.27:59200"
    S3_ENDPOINT: "http://172.31.5.27:59000"
    # Fronted with CloudFront (https://dbt9djtnw5ig5.cloudfront.net) rather
    # than the raw http://<ip>:59000 endpoint — an https admin/web page
    # loading http images is mixed content, which browsers block or
    # silently fail to upgrade, making verification-doc and profile-photo
    # images simply not render. Empirically verified a presigned URL
    # signed against the CloudFront domain still validates correctly
    # through it (CloudFront's Host-header rewrite to the origin doesn't
    # break MinIO's SigV4 check here) before switching this.
    S3_PUBLIC_ENDPOINT: "https://dbt9djtnw5ig5.cloudfront.net"
    S3_PUBLIC_HOST: "dbt9djtnw5ig5.cloudfront.net"
    S3_PUBLIC_BASE_URL: "https://dbt9djtnw5ig5.cloudfront.net/matrimony-photos"
    S3_BUCKET: "matrimony-photos"
    S3_DOCS_BUCKET: "matrimony-verification-docs"
    S3_USE_PATH_STYLE: "true"
    STUN_SERVER_URL: "stun:stun.l.google.com:19302"
    TURN_SERVER_URL: "turn:15.252.85.134:3478"
