# Codifies environment variables that a failed Elastic Beanstalk
# config-deploy has previously rolled back silently (2026-08-24 incident:
# KAFKA_BROKERS/ES_ADDRESSES reverted to a stale localhost snapshot,
# causing /search/profiles to fail with dial-refused / timeout errors).
#
# Baking these into the deployed bundle means every `eb deploy` /
# application-version deploy re-asserts the correct value from source
# control, instead of depending on a console-set variable that can
# silently drift or get rolled back. If the shared supporting-services
# host (Kafka/Elasticsearch/Redis/MinIO/Postgres) ever moves, update the
# IP here and redeploy — do not edit this only in the Beanstalk console.
option_settings:
  aws:elasticbeanstalk:application:environment:
    KAFKA_BROKERS: "172.31.5.27:59092"
    ES_ADDRESSES: "http://172.31.5.27:59200"
