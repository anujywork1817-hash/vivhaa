APP_ENV=dev

HTTP_PORT=8080

# Launch switch: the app runs fully free (chat sending, contact-info
# reveal, etc. all unlocked for everyone) until this is set to "true".
# Flip this together with frontend/lib/shared/models/my_subscription.dart's
# kPremiumFeatureEnabled when premium is ready to actually launch.
PREMIUM_GATING_ENABLED=false

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=myapp
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MIN=30

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_HOURS=720

# Local dev uses the MinIO container (S3-compatible). Point at real AWS S3
# in staging/prod by clearing S3_ENDPOINT and setting real credentials.
S3_ENDPOINT=http://localhost:59000
# Address a browser can reach to follow a presigned document URL — see
# BUG-C06. Usually the same as S3_ENDPOINT in local dev; must be set to
# this machine's LAN IP if devices other than localhost need to view
# verification documents through the admin panel.
S3_PUBLIC_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=matrimony-photos
# Private bucket for verification documents (government ID, selfies) —
# never public-read, unlike S3_BUCKET above. Access is only ever via a
# short-lived signed URL minted when an admin actively reviews a request.
S3_DOCS_BUCKET=matrimony-verification-docs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_USE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:59000/matrimony-photos

# WebRTC video/voice calling. STUN_SERVER_URL defaults to Google's free
# public STUN if unset — fine for most direct P2P connections. TURN_SERVER_URL
# + TURN_SECRET point at the self-hosted coturn service (docker-compose)
# for the relay fallback NAT traversal sometimes needs (symmetric NAT,
# strict corporate firewalls); TURN_SECRET must match coturn's own
# `static-auth-secret` — it's used to generate short-lived TURN credentials
# per call (GET /video-call/ice-servers), never a hardcoded password.
#
# TURN_SERVER_URL is handed to *client devices* (like S3_PUBLIC_BASE_URL
# above) — "localhost" resolves to the phone itself, not this machine, so
# a real device can never reach coturn through it. Use this dev machine's
# LAN IP (same one API_BASE_URL/_devMachineLanIp use on the frontend) —
# update it here if that IP ever changes.
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=turn:192.168.1.47:3478
TURN_SECRET=dev-turn-secret-change-me
